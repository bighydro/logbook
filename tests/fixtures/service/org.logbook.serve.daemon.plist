<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.logbook.serve</string>
	<key>UserName</key>
	<string>ines</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/logbook/venv/bin/python3</string>
		<string>-m</string>
		<string>logbook.cli</string>
		<string>serve</string>
		<string>--port</string>
		<string>8765</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>StandardOutPath</key>
	<string>@LOG@</string>
	<key>StandardErrorPath</key>
	<string>@LOG@</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>@HOME@</string>
		<key>LOGBOOK_HOME</key>
		<string>@LOGBOOK_HOME@</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>
</dict>
</plist>
